# Payload
PAYLOAD_SECRET=your_random_secret_here
PAYLOAD_PUBLIC_SERVER_URL=https://www.yasmineplastics.com

# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full&channel_binding=require

# Cloudflare
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Cloudflare R2
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.yasmineplastics.com

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=your_contact_email@example.com

# Background Removal (Modal + Bria RMBG 2.0)
MODAL_BG_REMOVE_URL=https://your-modal-endpoint.modal.run/

# Rate Limiting (Upstash)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Error Monitoring (Sentry)
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
