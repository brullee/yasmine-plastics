{
  "name": "yasmine-plastics",
  "version": "1.1.13",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "check": "tsc --noEmit && eslint src/ .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "next build && git push --follow-tags",
    "deploy:patch": "next build && npm version patch && git push --follow-tags",
    "deploy:minor": "next build && npm version minor && git push --follow-tags",
    "deploy:major": "next build && npm version major && git push --follow-tags",
    "sync": "git fetch origin && git merge --ff-only origin/main"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@payloadcms/db-postgres": "^3.92.0",
    "@payloadcms/email-resend": "^3.92.0",
    "@payloadcms/next": "^3.92.0",
    "@payloadcms/richtext-lexical": "^3.92.0",
    "@payloadcms/storage-s3": "^3.92.0",
    "@sentry/nextjs": "^10.63.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.3",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.2.7",
    "next-intl": "^4.14.9",
    "otpauth": "^9.5.2",
    "payload": "^3.85.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "sass": "^1.106.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "playwright": "^1.61.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3"
  }
}
