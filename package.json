{
  "name": "yasmine-plastics",
  "version": "1.0.13",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "check": "tsc --noEmit && eslint src/ .",
    "deploy": "next build && git push --follow-tags",
    "deploy:patch": "next build && npm version patch && git push --follow-tags",
    "deploy:minor": "next build && npm version minor && git push --follow-tags",
    "deploy:major": "next build && npm version major && git push --follow-tags"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.2",
    "@payloadcms/db-postgres": "^3.85.1",
    "@payloadcms/email-resend": "^3.85.1",
    "@payloadcms/next": "^3.85.1",
    "@payloadcms/richtext-lexical": "^3.85.1",
    "@payloadcms/storage-s3": "^3.85.1",
    "@sentry/nextjs": "^10.63.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.5",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.2.7",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "payload": "^3.85.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.12.4",
    "sass": "^1.101.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "playwright": "^1.61.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
